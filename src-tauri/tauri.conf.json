{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myLFR Desktop",
  "version": "0.8.0",
  "identifier": "nz.co.mylfr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myLFR Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#061f23",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/fishstock-catalogue.json"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "./windows/English.nsh"
        },
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Magnifica101/myLFR-desktop/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERjlFRTA5MkNCODZDMDUKUldRRmJMZ3NDZTc1L1JqQjdhOGtCMzdUTllaTUdDeG5QaVYxVk5xZCthaGJGRWNhMlorYUU5bmMK"
    }
  }
}
