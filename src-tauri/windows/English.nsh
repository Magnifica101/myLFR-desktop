; Plain-English installer wording for non-technical receivers.
; This file is included after the standard NSIS English strings so these
; product-specific strings replace the default technical wording.

; Standard installer pages.
LangString MUI_TEXT_WELCOME_INFO_TITLE ${LANG_ENGLISH} "Welcome to myLFR Desktop"
LangString MUI_TEXT_WELCOME_INFO_TEXT ${LANG_ENGLISH} "Thanks for choosing myLFR Desktop.$\r$\n$\r$\nThis will install myLFR Desktop on your computer.$\r$\n$\r$\nPlease close any other programs before continuing. This helps the installation finish properly.$\r$\n$\r$\nClick Next to continue, or Cancel to stop."
LangString MUI_TEXT_DIRECTORY_TITLE ${LANG_ENGLISH} "Where should myLFR Desktop be installed?"
LangString MUI_TEXT_DIRECTORY_SUBTITLE ${LANG_ENGLISH} "Choose where to install the app."
LangString MUI_TEXT_DIRECTORY_INFO_TITLE ${LANG_ENGLISH} "Install folder"
LangString MUI_TEXT_DIRECTORY_INFO_TEXT ${LANG_ENGLISH} "myLFR Desktop is ready to be installed. We recommend using the folder already shown below. You do not need to change it. Your business records and backup files are stored separately.$\r$\n$\r$\nOnly choose another folder if someone from myLFR has asked you to."
LangString MUI_TEXT_INSTALLING_TITLE ${LANG_ENGLISH} "Installation finished"
LangString MUI_TEXT_INSTALLING_SUBTITLE ${LANG_ENGLISH} "myLFR Desktop has been installed successfully. Click Next to choose what happens next."
LangString MUI_TEXT_FINISH_TITLE ${LANG_ENGLISH} "myLFR Desktop is ready"
LangString MUI_TEXT_FINISH_SUBTITLE ${LANG_ENGLISH} "The installation is complete."
LangString MUI_TEXT_FINISH_INFO_TITLE ${LANG_ENGLISH} ""
LangString MUI_TEXT_FINISH_INFO_TEXT ${LANG_ENGLISH} "myLFR Desktop is now installed.$\r$\n$\r$\nChoose what you would like to happen next, then click Finish. The app will guide you through setting up your business details the first time it opens."
LangString MUI_TEXT_FINISH_RUN ${LANG_ENGLISH} "Open myLFR Desktop now"
LangString MUI_TEXT_FINISH_SHOWREADME ${LANG_ENGLISH} "Add a shortcut to myLFR Desktop on my desktop"

; Standard uninstaller pages.
LangString MUI_UNTEXT_CONFIRM_TITLE ${LANG_ENGLISH} "Remove myLFR Desktop"
LangString MUI_UNTEXT_CONFIRM_SUBTITLE ${LANG_ENGLISH} "Choose what you would like to remove."
LangString MUI_UNTEXT_CONFIRM_TEXT ${LANG_ENGLISH} "This will remove the myLFR Desktop program from your computer. Your business records will be kept unless you select the option below."
LangString MUI_UNTEXT_UNINSTALLING_TITLE ${LANG_ENGLISH} "Removing myLFR Desktop"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE ${LANG_ENGLISH} "Please wait while myLFR Desktop is removed."
LangString MUI_UNTEXT_FINISH_TITLE ${LANG_ENGLISH} "myLFR Desktop was removed"
LangString MUI_UNTEXT_FINISH_SUBTITLE ${LANG_ENGLISH} "The program was removed. Your business records were kept unless you chose to delete them."

; Tauri's maintenance and safety strings.
LangString alreadyInstalled ${LANG_ENGLISH} "myLFR Desktop is already installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "An earlier version of myLFR Desktop is already on this computer. If you have already entered records, please make sure you have a recent backup before continuing."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose what you would like to do."
LangString addOrReinstall ${LANG_ENGLISH} "Repair or reinstall myLFR Desktop"
LangString uninstallApp ${LANG_ENGLISH} "Remove myLFR Desktop"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An earlier version of myLFR Desktop is already on this computer. If you have already entered records, please make sure you have a recent backup before continuing."
LangString choowHowToInstall ${LANG_ENGLISH} "Choose how you want to continue."
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Remove the earlier version, then install this version (Recommended)"
LangString dontUninstall ${LANG_ENGLISH} "Install this version without removing the earlier version first"
LangString createDesktop ${LANG_ENGLISH} "Add a shortcut to myLFR Desktop on my desktop"
LangString deleteAppData ${LANG_ENGLISH} "Also permanently delete myLFR business records saved on this computer"
LangString appRunning ${LANG_ENGLISH} "myLFR Desktop is still open. Please save your work, close myLFR Desktop, and try again."
LangString appRunningOkKill ${LANG_ENGLISH} "myLFR Desktop is still open.$\r$\n$\r$\nPlease save your work and close myLFR Desktop, then click OK to try again."
LangString failedToKillApp ${LANG_ENGLISH} "myLFR Desktop is still open. Please save your work, close myLFR Desktop, and try again."
